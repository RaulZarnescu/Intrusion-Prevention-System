# CLion / JetBrains IDE files
.idea/

# CMake build directories
build/
cmake-build-*/
cmake-build-debug/

# Compiled object files
*.o

# eBPF generated skeleton headers
*.skel.h

# Compiled executables (add specific names if you have them, e.g., ips_app)
*.out
fast_path/ips_loader
fast_path/ips_injector

# Machine-specific runtime config -- copy from the matching .example file and
# edit for this host (interface names, absolute paths)
config/config.ini
scripts/ips-loader.service

# Runtime-generated state (bans, tracked IPs, allowlist, honeypot hits) --
# regenerated per-deployment, not shared across machines
data/*.csv

# BPF CO-RE relocation header, regenerated per target kernel via:
#   bpftool btf dump file /sys/kernel/btf/vmlinux format c > fast_path/vmlinux.h
fast_path/vmlinux.h