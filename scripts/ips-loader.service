[Unit]
Description=IPS Fast-Path XDP Daemon
After=network-online.target
# Starting this unit also starts the threat-intel and SNI blocklist refresh timers, so a
# single `systemctl enable --now ips-loader.service` is enough — no separate sudo command
# needed to arm either timer. Wants=, not Requires=: a failed/missing timer must never
# block or crash the daemon itself.
Wants=network-online.target ips-threat-intel-update.timer ips-sni-blocklist-update.timer

[Service]
Type=simple
# EDIT: path to the repo's build dir on this host
WorkingDirectory=/home/raul/CLionProjects/Intrusion-Prevention-System/build
# Builds br0 from wan_interface/lan_interface in config.ini before the daemon attaches XDP
# to them -- without this, the two interfaces are never actually connected to each other at
# the OS level (see setup_bridge.sh's own header comment). Runs on every start, not just
# once, since it's idempotent and this doesn't persist across reboots on its own.
# EDIT: path to the repo on this host
ExecStartPre=/home/raul/CLionProjects/Intrusion-Prevention-System/scripts/setup_bridge.sh
# EDIT: matching path to the built binary
ExecStart=/home/raul/CLionProjects/Intrusion-Prevention-System/build/fast_path/ips_loader
Restart=on-failure
RestartSec=5
# Needs raw root to load BPF programs and attach XDP.
User=root

[Install]
WantedBy=multi-user.target
