# Your Ngrok auth token (from https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=your_auth_token_here

# Jenkins admin account — created automatically by JCasC on first boot
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change_me

# GitHub Personal Access Token — used by Jenkins to check out the repo and
# authenticate webhook/API calls (needs repo scope)
GITHUB_TOKEN=your_github_token_here
