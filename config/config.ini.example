# /config/config.ini.example
# Copy this file to config/config.ini and edit the values below for this host.
# config/config.ini itself is gitignored -- every deployment (dev machine, each
# physical box) keeps its own local copy, since wan_interface/lan_interface and
# excluded_source_ips are specific to that machine's NICs and network.

ban_duration_seconds = 3600
token_bucket_max = 50
token_refill_rate = 20
max_tolerated_drops = 15
threat_intel_refresh_seconds = 86400
allowlist_ttl_seconds = 900
state_dump_interval_seconds = 5
# Fill in with this host's real interface names, e.g. from `ip -brief link show`.
wan_interface = eth0
lan_interface = eth1
# Comma-separated CIDR list, exempt from the greylist bootstrap (e.g. this host's own
# bridged traffic reflecting back, plus loopback). Add any host-specific management/
# test subnets here.
excluded_source_ips = 127.0.0.0/8
# BCP38 anti-spoof (Stage 0.1): drops any WAN-arriving packet whose source looks
# private/RFC1918, on the assumption WAN means the real internet. Leave this at 1 for
# a real deployment. Set to 0 only on a nested test rig where the "WAN" side is itself
# just another private LAN (e.g. behind a home router) -- otherwise every legitimate
# packet from that side looks "internal" and gets silently dropped.
anti_spoof_enabled = 1
# Stage 2.6 (out-of-state ACK / ACK-Window/Maimon scan detection): for this many seconds
# after ips_loader starts, a bare ACK/FIN-ACK with no recorded SYN is let through instead of
# banned, so connections already established before this restart (an existing SSH session
# into this box included) survive. Keep this comfortably above how long a restart+reconnect
# actually takes on this host.
conn_track_grace_period_seconds = 30
